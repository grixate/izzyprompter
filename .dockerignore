# Deny by default: no Git history, local env, scripts, test artifacts, bundled
# Mac runtimes, browser state, node_modules, or existing host releases uploaded.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!vite.config.ts
!scripts/
scripts/*
!scripts/offlinePlugin.ts
!public/
!public/**
!src/
!src/**
!api/
api/*
!api/mix.exs
!api/mix.lock
!api/config/
!api/config/*.exs
!api/lib/
!api/lib/**
!api/priv/
api/priv/*
!api/priv/gettext/
!api/priv/gettext/**
!api/priv/repo/
!api/priv/repo/**
!api/priv/static/
api/priv/static/*
!api/priv/static/robots.txt
!api/priv/static/favicon.ico
# Re-exclude sensitive/generated material even inside included source folders.
**/.env*
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/_build
**/_build/**
**/deps
**/deps/**
**/*.pem
**/*.key
**/erl_crash.dump
api/priv/static/app
api/priv/static/app/**
