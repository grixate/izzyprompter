# Export these in your shell/process manager. Phoenix does not load dotenv files.
# Optional split-origin guest WebSocket override (bundled releases ignore it).
# Example: VITE_SOCKET_URL=wss://realtime.example.com/socket
VITE_SOCKET_URL=
# Guest-only mode needs none of these; DATABASE_URL opts into accounts.
DATABASE_URL=postgresql://izzy:replace-me@127.0.0.1:5432/izzy_dev
PUBLIC_ORIGIN=http://localhost:5173
MAIL_FROM=account@izzyprompter.com
# Development uses Swoosh.Local; production requires a verified SMTP service.
# Yandex Cloud Postbox: same folder as the verified sending domain.
# SMTP_HOST=postbox.cloud.yandex.net
# SMTP_PORT=587
# API key ID and secret, scoped to yc.postbox.send; never use VITE_* for secrets.
# SMTP_USERNAME=
# SMTP_PASSWORD=
# See docs/POSTBOX_EMAIL.md for DNS, credential storage and delivery checks.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public release only; use one always-on instance behind HTTPS.
# PHX_SERVER=true
# IZZY_MODE=public
# PORT=4000
# SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
# POOL_SIZE=10
# DATABASE_SSL_VERIFY=true

# Lifetime Pro: US$29 once, exclusively through lava.top.
# Keep off until merchant setup and a verified purchase/refund check are complete.
# Server-owned offer: true = $29 launch against $49 reference; false = $49.
IZZY_LAUNCH_OFFER_ACTIVE=true

# See docs/LAVA_TOP.md. Keys belong in the server environment, never VITE_*.
IZZY_PAYMENTS_ENABLED=false
LAVA_APPROVED=false
LAVA_CURRENCIES=USD
# LAVA_OFFER_ID=your-one-time-price-on-request-offer-uuid
# LAVA_API_KEY=outbound-api-key
# LAVA_WEBHOOK_SECRET=dedicated-inbound-secret-not-the-api-key
