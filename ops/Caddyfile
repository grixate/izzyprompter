{
	admin localhost:2019
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 32KB
	}
}
izzyprompter.com {
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 3MB
	}
	reverse_proxy 127.0.0.1:4000 {
		header_up X-Forwarded-For {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
www.izzyprompter.com {
	redir https://izzyprompter.com{uri} permanent
}

staging.izzyprompter.com {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "private, no-store"
	}
	# Only Lava's exact POST callback uses the app's X-Api-Key authentication.
	# All other requests retain staging's HTTP Basic protection.
	@review_only {
		not {
			method POST
			path /api/payments/lava
		}
	}
	# Caddy 2.6 uses the older basicauth directive name. Keep hashes out of Git.
	basicauth @review_only bcrypt "IZZY staging" {
		import /etc/caddy/staging-users
	}
	request_body {
		max_size 3MB
	}
	reverse_proxy 127.0.0.1:4001 {
		header_up X-Forwarded-For {remote_host}
		header_up -Authorization
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
