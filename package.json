{
  "name": "teleprompter-local-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "cd api && mix phx.server",
    "build": "tsc -b && vite build",
    "test": "npm run build && cd api && mix test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "phoenix": "^1.8.15",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/phoenix": "^1.6.7",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5"
  }
}
